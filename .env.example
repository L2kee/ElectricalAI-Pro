# Copy this file to .env in the project root and fill in your key.
# Get an NVIDIA Build API key from https://build.nvidia.com/

NVIDIA_API_KEY=your_nvidia_api_key_here

# Chat model on the NVIDIA OpenAI-compatible endpoint.
# Use a chat/instruct model, not an image/diffusion model.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Copy this file to .env in the project root and fill in your key.
# Get an NVIDIA Build API key from https://build.nvidia.com/

NVIDIA_API_KEY=your_nvidia_api_key_here

# Chat model on the NVIDIA OpenAI-compatible endpoint.
# Use a chat/instruct model that supports tool/function calling, not an
# image/diffusion model. Check https://build.nvidia.com/models for current
# offerings if this one is ever retired — NVIDIA does EOL models over time.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
